{
  "local_root_path": "./pipeline/shared/",
  "remote_root_path": "s3://pedp-data-preserved/ejscreen-data-processing/pipeline/shared/",
  "download_settings": {
    "request_timeout_seconds": 120,
    "chunk_size_bytes": 1048576
  },
  "assets": {
    "census_block_weights": {
      "display_name_short": "Census Block Weights",
      "display_name_long": "Census Block Population Weights",
      "provider": "US Census Bureau",
      "description": "Census block population weights calculated using 2020 Census tabulation blocks and 2022 ACS block-group population data.",
      "1.0": {
        "data_period": "2020, 2022",
        "stages": {
          "fetch": {
            "notes": "These details added to support v4.2024.0 documentation. R code not currently using this info.",
            "outputs": {
              "census_block_tabulations_2020": {
                "type": "download",
                "scope": "state",
                "source_url_template": "https://www2.census.gov/geo/tiger/TIGER2020/TABBLOCK20/tl_2020_{fips}_tabblock20.zip",
                "relative_path_template": "census_block_weights/1.0/downloads/tiger_blocks_2020/tl_2020_{fips}_tabblock20.zip",
                "notes": "2020 Census tabulation blocks used to calculate block-group population weights."
              },
              "acs_block_group_population_2022": {
                "type": "api_call",
                "scope": "state",
                "source_url_template": "https://api.census.gov/data/2022/acs/acs5?get=NAME%2CB01003_001&for=block%20group%3A%2A&in=state%3A{fips}%20county%3A%2A",
                "relative_path_template": "census_block_weights/1.0/downloads/acs_2022/block_group_population_{fips}.json",
                "notes": "ACS 2022 5-year API response for block-group total population (B01003_001). tidycensus retrieves this data during preprocessing tidycensus::get_acs(geography = \"block group\", variables = \"B01003_001\", state = {fips}, year = 2022)."
              },
              "block_crosswalk_2022": {
                "type": "download",
                "scope": "single",
                "source_url": "https://raw.githubusercontent.com/CT-Data-Collaborative/2022-block-crosswalk/main/2022blockcrosswalk.csv",
                "relative_path": "census_block_weights/1.0/downloads/2022blockcrosswalk.csv",
                "notes": "CT Data Collaborative 2020-to-2022 block crosswalk, read when Census block-group counts do not match."
              }
            }
          },
          "preprocess": {
            "outputs": {
              "census_block_weights": {
                "type": "shared_asset",
                "scope": "single",
                "relative_path_template": "census_block_weights/1.0/preprocessed_input/census_block_weights_2020_w2022pops.csv"
              }
            }
          }
        },
        "notes": "These are EmmaLi's new-improved weights that include the acs_2022_bg_pop column to use for identifying zero-population block groups."
      },
      "0.6": {
        "data_period": "2020",
        "stages": {
          "preprocess": {
            "outputs": {
              "census_block_weights": {
                "type": "shared_asset",
                "scope": "single",
                "relative_path_template": "census_block_weights/0.6/preprocessed_input/census_block_weights_2020.csv"
              }
            }
          }
        },
        "notes": "These are still EmmaLi's original weights, but we're going to read the whole-country file, not one postal code at a time."
      },
      "0.5": {
        "data_period": "2020",
        "stages": {
          "preprocess": {
            "outputs": {
              "census_block_weights": {
                "type": "shared_asset",
                "scope": "postal",
                "relative_path_template": "census_block_weights/0.5/preprocessed_input/census_block_weights_2020_{postal}.csv"
              }
            }
          }
        },
        "notes": "These were EmmaLi's original weights, used up through her fix for issues #15 and #16."
      }
    },
    "tiger_state": {
      "display_name_short": "TIGER State",
      "display_name_long": "TIGER State-level geographic data",
      "provider": "US Census Bureau",
      "description": "TIGER State-level geographic data provided by the US Census Bureau.",
      "2020": {
        "data_period": "2020",
        "stages": {
          "fetch": {
            "outputs": {
              "tiger_state_2020": {
                "type": "download",
                "scope": "state",
                "source_url_template": "https://www2.census.gov/geo/tiger/TIGER2020/STATE/tl_2020_us_state.zip",
                "relative_path_template": "downloads/tiger_lines/2020/state/tl_2020_us_state.zip"
              }
            }
          }
        }
      }
    },
    "tiger_county": {
      "display_name_short": "TIGER County",
      "display_name_long": "TIGER County-level geographic data",
      "provider": "US Census Bureau",
      "description": "TIGER County-level geographic data provided by the US Census Bureau.",
      "2020": {
        "data_period": "2020",
        "stages": {
          "fetch": {
            "outputs": {
              "tiger_county_2020": {
                "type": "download",
                "scope": "state",
                "source_url_template": "https://www2.census.gov/geo/tiger/TIGER2020/COUNTY/tl_2020_us_county.zip",
                "relative_path_template": "downloads/tiger_lines/2020/county/tl_2020_us_county.zip"
              }
            }
          }
        }
      }
    },
    "tiger_tract": {
      "display_name_short": "TIGER Tract",
      "display_name_long": "TIGER Census Tract-level geographic data",
      "provider": "US Census Bureau",
      "description": "TIGER Census Tract-level geographic data provided by the US Census Bureau.",
      "2020": {
        "data_period": "2020",
        "stages": {
          "fetch": {
            "outputs": {
              "tiger_tract_2020": {
                "type": "download",
                "scope": "state",
                "source_url_template": "https://www2.census.gov/geo/tiger/TIGER2020/TRACT/tl_2020_{fips}_tract.zip",
                "relative_path_template": "downloads/tiger_lines/2020/tract/tl_2020_{fips}_tract.zip"
              }
            }
          }
        }
      }
    },
    "tiger_bg": {
      "display_name_short": "TIGER Block Group",
      "display_name_long": "TIGER Block Group-level geographic data",
      "provider": "US Census Bureau",
      "description": "TIGER Block Group-level geographic data provided by the US Census Bureau.",
      "2020": {
        "data_period": "2020",
        "stages": {
          "fetch": {
            "outputs": {
              "tiger_bg_2020": {
                "type": "download",
                "scope": "state",
                "source_url_template": "https://www2.census.gov/geo/tiger/TIGER2020/BG/tl_2020_{fips}_bg.zip",
                "relative_path_template": "downloads/tiger_lines/2020/bg/tl_2020_{fips}_bg.zip"
              }
            }
          }
        }
      }
    },
    "tiger_block": {
      "display_name_short": "TIGER Block",
      "display_name_long": "TIGER Block-level geographic data",
      "provider": "US Census Bureau",
      "description": "TIGER Block-level geographic data provided by the US Census Bureau.",
      "2022": {
        "data_period": "2022",
        "stages": {
          "fetch": {
            "outputs": {
              "tiger_block_2022": {
                "type": "download",
                "scope": "state",
                "source_url_template": "https://www2.census.gov/geo/tiger/TIGER2022/TABBLOCK20/tl_2022_{fips}_tabblock20.zip",
                "relative_path_template": "downloads/tiger_lines/2022/tabblock20/tl_2022_{fips}_tabblock20.zip"
              }
            }
          }
        }
      },
      "2020": {
        "data_period": "2020",
        "stages": {
          "fetch": {
            "outputs": {
              "tiger_block_2020": {
                "type": "download",
                "scope": "state",
                "source_url_template": "https://www2.census.gov/geo/tiger/TIGER2020/TABBLOCK20/tl_2020_{fips}_tabblock20.zip",
                "relative_path_template": "downloads/tiger_lines/2020/tabblock20/tl_2020_{fips}_tabblock20.zip"
              }
            }
          }
        }
      }
    }
  }
}
