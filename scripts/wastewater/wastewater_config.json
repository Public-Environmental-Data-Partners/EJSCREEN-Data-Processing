{
  "local_root_path": "pipeline/wastewater/",
  "remote_root_path": "s3://pedp-data-preserved/ejscreen-data-processing/pipeline/wastewater/",
  "download_settings": {
    "request_timeout_seconds": 120,
    "chunk_size_bytes": 1048576
  },
  "versions": {
    "1.2021": {
      "required_shared_assets": {
        "census_block_weights": "1.0"
      },
      "notes": "Original 2021 version data",
      "stages": {
        "fetch": {
          "outputs": {
            "offsite": {
              "type": "download",
              "relative_path": "v{version}/downloads/2021/NHDMicroResults_conc_aggoffsite.zip",
              "source_url": "http://abt-rsei.s3.amazonaws.com/microdata2021/water/NHDMicroResults_conc_aggoffsite.zip",
              "notes": "Check for updates at: https://www.epa.gov/rsei/ways-get-rsei-results"
            },
            "onsite": {
              "type": "download",
              "relative_path": "v{version}/downloads/2021/NHDMicroResults_conc_aggonsite.zip",
              "source_url": "http://abt-rsei.s3.amazonaws.com/microdata2021/water/NHDMicroResults_conc_aggonsite.zip",
              "notes": "Check for updates at: https://www.epa.gov/rsei/ways-get-rsei-results"
            }
          }
        },
        "preprocess": {
          "inputs": {
            "offsite": {
              "type": "indicator_download",
              "key": "offsite"
            },
            "onsite": {
              "type": "indicator_download",
              "key": "onsite"
            }
          },
          "outputs": {
            "output_directory": {
              "type": "directory",
              "relative_path": "v{version}/preprocessed_input/"
            }
          }
        },
        "score": {
          "inputs": {
            "preprocessed_microdata": {
              "type": "file",
              "relative_path": "v{version}/preprocessed_input/water_microdata_2021_by_comid.parquet"
            },
            "weights": {
              "type": "shared_asset",
              "key": "census_block_weights",
              "category": "preprocessed_input"
            }
          },
          "outputs": {
            "output_directory": {
              "type": "directory",
              "relative_path": "v{version}/score_output/"
            },
            "indicator_output_template": {
              "type": "template",
              "relative_path": "v{version}/score_output/final_bg_scores_{postal}.csv"
            }
          }
        }
      }
    },
    "1.2022": {
      "required_shared_assets": {
        "census_block_weights": "1.0"
      },
      "notes": "2022 version data",
      "stages": {
        "fetch": {
          "outputs": {
            "offsite": {
              "type": "download",
              "relative_path": "v{version}/downloads/2022/NHDMicroResults_conc_aggOffsite.zip",
              "source_url": "http://abt-rsei.s3.amazonaws.com/microdata2022/water/NHDMicroResults_conc_aggOffsite.zip",
              "notes": "Check for updates at: https://www.epa.gov/rsei/ways-get-rsei-results"
            },
            "onsite": {
              "type": "download",
              "relative_path": "v{version}/downloads/2022/NHDMicroResults_conc_aggOnsite.zip",
              "source_url": "http://abt-rsei.s3.amazonaws.com/microdata2022/water/NHDMicroResults_conc_aggOnsite.zip",
              "notes": "Check for updates at: https://www.epa.gov/rsei/ways-get-rsei-results"
            }
          }
        },
        "preprocess": {
          "inputs": {
            "offsite": {
              "type": "indicator_download",
              "key": "offsite"
            },
            "onsite": {
              "type": "indicator_download",
              "key": "onsite"
            }
          },
          "outputs": {
            "output_directory": {
              "type": "directory",
              "relative_path": "v{version}/preprocessed_input/"
            }
          }
        },
        "score": {
          "inputs": {
            "preprocessed_microdata": {
              "type": "file",
              "relative_path": "v{version}/preprocessed_input/water_microdata_2022_by_comid.parquet"
            },
            "weights": {
              "type": "shared_asset",
              "key": "census_block_weights",
              "category": "preprocessed_input"
            }
          },
          "outputs": {
            "output_directory": {
              "type": "directory",
              "relative_path": "v{version}/score_output/"
            },
            "indicator_output_template": {
              "type": "template",
              "relative_path": "v{version}/score_output/final_bg_scores_{postal}.csv"
            }
          }
        }
      }
    }
  }
}
